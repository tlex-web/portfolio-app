# Vercel Analytics & Speed Insights
# These are automatically enabled when deployed to Vercel
# No configuration needed - they work out of the box!

# Email Configuration (Required for contact form email functionality)
# Sign up at https://resend.com to get your API key
# RESEND_API_KEY=re_123456789
# FEEDBACK_RECIPIENT_EMAIL=your.email@example.com
# FEEDBACK_FROM_EMAIL=noreply@yourdomain.com

# For local development/testing without email functionality:
# Set dummy values to allow build/tests to run:
# RESEND_API_KEY=dummy_key_for_development
# FEEDBACK_RECIPIENT_EMAIL=test@example.com
# FEEDBACK_FROM_EMAIL=noreply@example.com

# Rate Limiting (Required in production: the contact form refuses without it)
# Create a free Redis database at https://console.upstash.com
# Or provision via Vercel Marketplace -> Upstash integration (auto-injects env vars)
# Set ONE complete pair. The UPSTASH_ pair is read first, then the KV_ pair
# (the names the Vercel integration injects); a URL from one pair is never
# combined with the token from the other, and an empty value counts as missing.
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_token_here
# or
# KV_REST_API_URL=https://your-database.upstash.io
# KV_REST_API_TOKEN=your_token_here
#
# When VERCEL_ENV is 'production', a missing pair, a Redis error or a timeout
# refuses the submission (503; the form shows "Couldn't send"). VERCEL_ENV comes
# from Vercel's system environment variables, so it is never set here. Previews
# and local dev run without a pair: rate limiting is then off, with one warning.

# Analytics (Optional)
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=your_vercel_analytics_id
