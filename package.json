{
  "name": "portfolio-app",
  "version": "1.0.0",
  "description": "A modern portfolio website showcasing landscape photography and programming projects with 3D visualizations",
  "main": "index.js",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && npm run guard:parity && npm run guard:ci && npm run guard:palette && npm run guard:contrast && npm run guard:identity && npm run guard:selftest && npm run data:check && npm run guard:images && npm run guard:tests:scan",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit && tsc -p tsconfig.jest.json && tsc -p tsconfig.e2e.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:prod-form": "playwright test --config=playwright.prod.config.ts",
    "postbuild": "node scripts/inject-build-hash.mjs",
    "guard:parity": "node scripts/guards/check-install-parity.mjs",
    "guard:ci": "node scripts/guards/check-ci-gate.mjs",
    "guard:palette": "node scripts/guards/check-palette.mjs",
    "guard:contrast": "node scripts/guards/check-contrast.mjs",
    "guard:identity": "node scripts/guards/check-identity.mjs",
    "guard:selftest": "node scripts/guards/selftest.mjs",
    "guard:tests": "node scripts/guards/test-count.mjs --jest jest-results.json",
    "guard:tests:scan": "node scripts/guards/test-count.mjs --scan-only",
    "guard:images": "node scripts/guards/check-served-images.mjs",
    "photos:exif": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/photos/extract-exif.mjs",
    "photos:derive": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/photos/build-derivatives.mjs",
    "photos:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/photos/build-photo-data.mjs",
    "terrain:fetch": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/terrain/fetch-dem.mjs",
    "terrain:fetch:bev": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/terrain/fetch-bev.mjs",
    "terrain:fetch:overview": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/terrain/fetch-overview.mjs",
    "terrain:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/terrain/build-terrain.mjs",
    "trails:fetch": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/terrain/fetch-trails.mjs",
    "trails:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/terrain/build-trails.mjs",
    "clip:derive": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/media/build-clip.mjs",
    "icons:build": "node scripts/icons/build-icons.mjs",
    "tokens:build": "node scripts/tokens/build-tokens.mjs",
    "data:check": "npm run terrain:build -- --check && npm run photos:exif -- --check && npm run photos:derive -- --check && npm run photos:build -- --check && npm run tokens:build -- --check && npm run trails:build -- --check && npm run clip:derive -- --check"
  },
  "engines": {
    "node": "24.x"
  },
  "keywords": [
    "portfolio",
    "next.js",
    "typescript",
    "three.js",
    "photography",
    "3d",
    "webgl"
  ],
  "author": "Tim Lui (https://github.com/tlex-web)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tlex-web/portfolio-app.git"
  },
  "bugs": {
    "url": "https://github.com/tlex-web/portfolio-app/issues"
  },
  "homepage": "https://www.tlui.de",
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@react-spring/three": "^10.1.2",
    "@react-three/fiber": "^9.8.2",
    "@tailwindcss/postcss": "^4.3.4",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.41.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "fast-png": "8.0.0",
    "motion": "14.10.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "resend": "^6.37.0",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@jest/globals": "^30.5.2",
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.183.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.59.0",
    "autoprefixer": "^10.6.2",
    "colorjs.io": "^0.7.1",
    "cross-env": "^10.1.0",
    "d3-contour": "4.0.3",
    "eslint": "^9.28.0",
    "eslint-config-next": "^16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "exif-reader": "2.0.3",
    "geotiff": "3.0.5",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-mock": "30.5.2",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "proj4": "2.22.0",
    "schema-dts": "2.1.0",
    "sharp": "^0.35.5",
    "simplify-js": "1.2.4",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "fflate@^0.8.0": "0.8.3",
    "wkt-parser@^1.5.5": "1.5.6"
  }
}
